# Copy to .env and fill in only what you need. Nothing here is required for the
# offline demo: with every value empty, Review Radar runs on its demo model and
# the bundled Pocket Planner dataset.

# --- Models -------------------------------------------------------------------
# Any PydanticAI model id, e.g. openai:gpt-5.4-mini or anthropic:<model>.
# Leave MODEL empty to use openai:gpt-5.4-mini when OPENAI_API_KEY is set,
# or the offline demo model otherwise.
MODEL=
EMBEDDING_MODEL=
OPENAI_API_KEY=

# --- App Store Connect (read reviews, post responses) ------------------------
APP_STORE_APP_ID=
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
# Either the PEM contents or a path to the .p8 file.
APP_STORE_PRIVATE_KEY=
APP_STORE_PRIVATE_KEY_PATH=

# --- Google Play Developer API -----------------------------------------------
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# --- Behaviour ---------------------------------------------------------------
# Replies are only ever posted with store keys AND this set to true.
POSTING_ENABLED=
TRIAGE_CONCURRENCY=
CORS_ORIGINS=
LOG_LEVEL=
